# ==============================================================================
# Fence Frames — Production & Staging Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase (Database & Realtime Subscriptions)
# ------------------------------------------------------------------------------
# Found in: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://hikpszwtglrkfgivcdaa.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-public-key"
# Server-only service role key (Never expose to client/NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ------------------------------------------------------------------------------
# 1b. Staff desk gate (interim — until Supabase staff role exists)
# ------------------------------------------------------------------------------
# Shared operator key for /staff/gate → /admin. Never prefix with NEXT_PUBLIC_.
# If unset: local `next dev` can still open /admin; production/staging 404s /admin.
FF_STAFF_GATE_KEY=""

# ------------------------------------------------------------------------------
# 2. Telnyx (Contractor SMS 3-Seat Scramble Engine)
# ------------------------------------------------------------------------------
# Found in: Telnyx Mission Control Portal -> API Keys
TELNYX_API_KEY="KEY01...your-telnyx-api-key"
TELNYX_FROM_NUMBER="+1XXXXXXXXXX"
# Optional: Messaging Profile ID if using profile-based dispatch
TELNYX_MESSAGING_PROFILE_ID=""

# ------------------------------------------------------------------------------
# 3. Resend (HOA ARC Submittal Email Engine)
# ------------------------------------------------------------------------------
# Found in: Resend Dashboard -> API Keys
RESEND_API_KEY="re_...your-resend-api-key"
RESEND_FROM_EMAIL="Fence Frames Submittals <submittals@fenceframes.com>"