# ==============================================================================
# Fence Frames — Environment Configuration Template
# ==============================================================================

# Client-Side Supabase Keys (Public)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-Side API Secrets (Private — Set in Vercel Environment Variables)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
TELNYX_API_KEY=your-telnyx-sms-api-key
TELNYX_PHONE_NUMBER=+12065550100

# Transactional Email (Resend / SendGrid)
RESEND_API_KEY=re_your_api_key

# Payment Processing (Stripe Lead Marketplace)
STRIPE_SECRET_KEY=sk_live_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Vercel Analytics (Automatically injected on Vercel deployment)
NEXT_PUBLIC_VERCEL_ENV=production